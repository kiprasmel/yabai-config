#!/usr/bin/env sh

# the scripting-addition must be loaded manually if
# you are running yabai on macOS Big Sur. Uncomment
# the following line to have the injection performed
# when the config is executed during startup.
#
# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# see this wiki page for information:
#  - https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)
#
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# global settings
yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          off
yabai -m config window_placement             second_child
yabai -m config window_topmost               off
yabai -m config window_shadow                on
yabai -m config window_opacity               off
yabai -m config window_opacity_duration      0.0
yabai -m config active_window_opacity        1.0
yabai -m config normal_window_opacity        0.90
yabai -m config window_border                off
yabai -m config window_border_width          6
yabai -m config active_window_border_color   0xff775759
yabai -m config normal_window_border_color   0xff555555
yabai -m config insert_feedback_color        0xffd75f5f
yabai -m config split_ratio                  0.50
yabai -m config auto_balance                 off
yabai -m config mouse_modifier               fn
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize
yabai -m config mouse_drop_action            swap

# general space settings
yabai -m config layout                       stack # bsp
yabai -m config top_padding                  0 # 12
yabai -m config bottom_padding               0 # 12
yabai -m config left_padding                 0 # 12
yabai -m config right_padding                0 # 12
yabai -m config window_gap                   0 # 06

# ============================================================================
# Space snapshot tracking (for monitor plug/unplug fix)
# These signals track window-to-space mappings so we can restore after changes
# ============================================================================
SNAPSHOT_SCRIPT="${HOME}/.config/yabai/scripts/save-space-snapshot.sh"
FIX_UNPLUG_SCRIPT="${HOME}/.config/yabai/scripts/fix-unplug.sh"
FIX_PLUGIN_SCRIPT="${HOME}/.config/yabai/scripts/fix-plugin.sh"
AUTOFIX_FLAG="${HOME}/.cache/yabai/autofix-enabled"

# Track window movements between spaces
yabai -m signal --add label="snapshot_space_changed" event=space_changed action="$SNAPSHOT_SCRIPT"

# Track when windows are created or destroyed
yabai -m signal --add label="snapshot_window_created" event=window_created action="$SNAPSHOT_SCRIPT"
yabai -m signal --add label="snapshot_window_destroyed" event=window_destroyed action="$SNAPSHOT_SCRIPT"

# Track when windows move to different spaces
yabai -m signal --add label="snapshot_window_moved" event=window_moved action="$SNAPSHOT_SCRIPT"

# Conditionally enable auto-fix on display changes (if flag file contains "1")
if [ -f "$AUTOFIX_FLAG" ] && [ "$(cat "$AUTOFIX_FLAG")" = "1" ]; then
    yabai -m signal --add label="autofix_display_removed" event=display_removed action="$FIX_UNPLUG_SCRIPT"
    yabai -m signal --add label="autofix_display_added" event=display_added action="$FIX_PLUGIN_SCRIPT"
    echo "Autofix on display changes: ENABLED"
else
    echo "Autofix on display changes: DISABLED (run toggle-autofix.sh to enable)"
fi

echo "yabai configuration loaded.."
