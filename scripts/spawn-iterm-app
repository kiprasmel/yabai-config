#!/usr/bin/env bash

APP="${1:-/Applications/iTerm.app}"

spawn_app() {
	echo "spawning $APP"
	open -a "$APP"
}

# Activate existing iTerm only — never open -na (that spawns a second
# instance and breaks Opt+U hotkey scratchpad hide/show).
spawn_activate_fallback() {
	echo "AppleScript create-window failed; activating existing iTerm (no new instance)" >&2
	open -a "$APP"
}

if ! pgrep -f "iTerm" &>/dev/null; then
	spawn_app
else
	# Create a new window (requires Automation permission for the caller → iTerm2)
	if ! osascript -e 'tell application "iTerm2" to create window with default profile'; then
		spawn_activate_fallback
	fi
fi
